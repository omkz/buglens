# GitHub App configuration.
# Create a GitHub App at https://github.com/settings/apps/new and fill these in.
# Repository permissions: Metadata read, Contents read, Issues read and write.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# Provide the private key either as a file path (preferred for local dev)
# or inline. If GITHUB_PRIVATE_KEY_PATH is set, it takes precedence.
GITHUB_PRIVATE_KEY_PATH=
# Paste the PEM private key contents; escape newlines as \n if kept on one line.
GITHUB_PRIVATE_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Service URLs.
FRONTEND_BASE_URL=http://localhost:3000
BACKEND_BASE_URL=http://localhost:8000
GITHUB_CALLBACK_URL=http://localhost:8000/github/oauth/callback

# Logging.
# LOG_FORMAT=console for readable local development logs.
# LOG_FORMAT=json for production / Cloud Run.
LOG_LEVEL=INFO
LOG_FORMAT=console

# Database.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/buglens

# Evidence storage.
# local is intended for development.
EVIDENCE_STORAGE_BACKEND=local
EVIDENCE_STORAGE_DIR=.data/evidence

# Required when EVIDENCE_STORAGE_BACKEND=gcs.
# Authentication uses Google Application Default Credentials.
GCS_BUCKET=

MAX_EVIDENCE_UPLOAD_BYTES=104857600

# Gemini bug evidence analysis (backend only).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FILE_PROCESSING_TIMEOUT_SECONDS=300

# Local browser reproduction. Install Chromium explicitly for local runs:
# uv run playwright install chromium
PLAYWRIGHT_ACTION_TIMEOUT_MS=10000
PLAYWRIGHT_RUN_TIMEOUT_SECONDS=60
# Development only. Never enable in production.
PLAYWRIGHT_ALLOW_PRIVATE_NETWORK=false

# Browser session (signed, httponly cookie -- holds only the pending OAuth
# state and safe internal identifiers, never credentials).
# Generate a real random value for SESSION_SECRET in every deployed
# environment; set SESSION_COOKIE_SECURE=true once served over HTTPS.
SESSION_SECRET=replace-with-a-long-random-secret
SESSION_COOKIE_SECURE=false
