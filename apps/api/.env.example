# GitHub App configuration.
# Create a GitHub App at https://github.com/settings/apps/new and fill these in.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# Paste the PEM private key contents; escape newlines as \n if kept on one line.
GITHUB_PRIVATE_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Base URL of the BugLens frontend, used to redirect back after connecting GitHub.
FRONTEND_BASE_URL=http://localhost:3000
